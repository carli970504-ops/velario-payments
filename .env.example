# Keep this server outside APK/EXE. Secrets never belong in the apps.
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://payments.example.com
DATABASE_PATH=./data/velario.sqlite
# test by default. Set live only after provider sandbox checks.
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_PACKAGE_NAME=com.velario.app
GOOGLE_BASE_PLAN_ID=weekly
# Opcional: token de 24 caracteres o más para GET /api/diagnostics. Sin él la ruta responde 404.
DIAGNOSTICS_TOKEN=
# Clave con la que se firma el token de cada instalacion (minimo 32 caracteres).
# Si falta se deriva de STRIPE_SECRET_KEY, asi que las sesiones igualmente sobreviven
# a un reinicio. Definirla evita depender de esa clave y permite rotarla sin cortar sesiones.
ACCOUNT_SECRET=
